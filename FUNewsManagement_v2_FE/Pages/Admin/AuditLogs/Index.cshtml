@page
@model FUNewsManagement_v2_FE.Pages.Admin.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Nhật ký hệ thống";
}

<h2>Nhật ký hệ thống</h2>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Người dùng</label>
                <select id="userFilter" class="form-select">
                    <option value="">-- Tất cả người dùng --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Đối tượng</label>
                <select id="entityFilter" class="form-select">
                    <option value="">-- Tất cả đối tượng --</option>
                    <option value="SystemAccount">SystemAccount</option>
                    <option value="Tag">Tag</option>
                    <option value="NewsArticle">NewsArticle</option>
                    <option value="Category">Category</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Từ ngày</label>
                <input type="date" id="fromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Đến ngày</label>
                <input type="date" id="toDate" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <button type="button" class="btn btn-primary w-100" onclick="loadLogs()">Lọc</button>
            </div>
        </div>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Thời gian</th>
            <th>Người dùng</th>
            <th>Hành động</th>
            <th>Đối tượng</th>
            <th>Thay đổi</th>
        </tr>
    </thead>
    <tbody id="logsTableBody">
        <tr>
            <td colspan="5" class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
            </td>
        </tr>
    </tbody>
</table>

<div id="pagination" class="d-flex justify-content-center"></div>

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết lịch sử hoạt động</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <h6>Dữ liệu cũ</h6>
                        <pre id="beforeData" class="bg-light p-3" style="max-height: 300px; overflow-y: auto;"></pre>
                    </div>
                    <div class="col-6">
                        <h6>Dữ liệu mới</h6>
                        <pre id="afterData" class="bg-light p-3" style="max-height: 300px; overflow-y: auto;"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage = 1;
    let pageSize = 10;
    let detailModal;

    document.addEventListener('DOMContentLoaded', function() {
        detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
        loadUsers();
        loadLogs();
    });

    async function loadUsers() {
        try {
            const response = await fetch('/api/accounts?top=100');
            const data = await response.json();
            
            if (data && data.value) {
                const select = document.getElementById('userFilter');
                
                // Manually inject Admin (System) option since it's not in SystemAccount DB
                const adminOption = document.createElement('option');
                adminOption.value = "null";
                adminOption.textContent = "Admin (Hệ thống)";
                select.appendChild(adminOption);

                data.value.forEach(acc => {
                    const option = document.createElement('option');
                    option.value = acc.accountId;
                    option.textContent = acc.accountEmail || acc.accountName;
                    select.appendChild(option);
                });
            }
        } catch (error) {
            console.error('Error loading users:', error);
        }
    }

    async function loadLogs() {
        const userId = document.getElementById('userFilter').value;
        const entity = document.getElementById('entityFilter').value;
        const fromDateInput = document.getElementById('fromDate');
        const toDateInput = document.getElementById('toDate');
        const fromDate = fromDateInput.value;
        const toDate = toDateInput.value;
        
        if (fromDate && toDate) {
            const fDate = new Date(fromDate);
            const tDate = new Date(toDate);
            if (fDate > tDate) {
                showToast('Ngày bắt đầu không được sau ngày kết thúc', 'danger');
                return;
            }
        }
        
        let filters = [];
        if (userId) {
            if (userId === "null") {
                filters.push(`UserId eq null`);
            } else {
                filters.push(`UserId eq ${userId}`);
            }
        }
        if (entity) filters.push(`Entity eq '${entity}'`);
        if (fromDate) filters.push(`Timestamp ge ${fromDate}T00:00:00Z`);
        if (toDate) filters.push(`Timestamp le ${toDate}T23:59:59Z`);
        
        const filterStr = filters.length > 0 ? filters.join(' and ') : '';
        
        try {
            const response = await fetch(`/api/auditlogs?filter=${encodeURIComponent(filterStr)}&top=${pageSize}&skip=${(currentPage-1)*pageSize}&orderby=Timestamp desc`);
            const data = await response.json();
            
            if (data && data.value) {
                if (data.isOffline) {
                    const banner = document.getElementById('offlineBanner');
                    if (banner) banner.style.display = 'block';
                } else {
                    const banner = document.getElementById('offlineBanner');
                    if (banner) banner.style.display = 'none';
                }

                renderLogsTable(data.value);
                renderPagination(data.count || data.value.length);
            }
        } catch (error) {
            console.error('Error loading logs:', error);
            showToast('Lỗi khi tải audit logs', 'danger');
        }
    }

    function renderLogsTable(logs) {
        const tbody = document.getElementById('logsTableBody');
        if (logs.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Không có dữ liệu</td></tr>';
            return;
        }

        tbody.innerHTML = logs.map(log => {
            const timestamp = log.timestamp ? new Date(log.timestamp).toLocaleString('vi-VN') : '';
            return `
                <tr>
                    <td>${timestamp}</td>
                    <td>${log.userEmail || 'N/A'}</td>
                    <td><span class="badge bg-info">${log.action}</span></td>
                    <td>${log.entity}</td>
                    <td>
                        ${log.beforeData || log.afterData ? `<button type="button" class="btn btn-sm btn-outline-primary" onclick='showDetail(${JSON.stringify(log)})'>Xem</button>` : '-'}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function renderPagination(total) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = document.getElementById('pagination');
        
        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        let html = '<ul class="pagination">';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">Trước</a>
                 </li>`;
        
        for (let i = 1; i <= totalPages; i++) {
            html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                     </li>`;
        }
        
        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">Sau</a>
                 </li>`;
        html += '</ul>';
        
        pagination.innerHTML = html;
    }

    function changePage(page) {
        currentPage = page;
        loadLogs();
    }

    function showDetail(log) {
        document.getElementById('beforeData').textContent = log.beforeData ? JSON.stringify(JSON.parse(log.beforeData), null, 2) : 'N/A';
        document.getElementById('afterData').textContent = log.afterData ? JSON.stringify(JSON.parse(log.afterData), null, 2) : 'N/A';
        detailModal.show();
    }

    function showToast(message, type) {
        const toastContainer = document.getElementById('toastContainer');
        if (toastContainer) {
            const toastId = 'toast-' + Date.now();
            const bgClass = type === 'success' ? 'bg-success' : type === 'danger' ? 'bg-danger' : 'bg-info';
            
            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center ${bgClass} text-white border-0 mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            
            const template = document.createElement('template');
            template.innerHTML = toastHtml.trim();
            const toastElement = template.content.firstChild;
            toastContainer.appendChild(toastElement);
            
            const toast = new bootstrap.Toast(toastElement, { delay: 3000 });
            toast.show();
            
            toastElement.addEventListener('hidden.bs.toast', () => { 
                toastElement.remove(); 
            });
        } else {
            console.error('Toast container not found');
            alert(message);
        }
    }
</script>
}

