<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management v2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FUNewsManagement_v2_FE.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">FU News v2</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/News/Search">Tìm kiếm</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserName") != null)
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link text-dark position-relative mt-1" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell-fill fs-5"></i>
                                    <span id="notificationBadge" class="position-absolute top-25 start-75 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.6em; margin-top: 5px;">
                                        0
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationDropdown" id="notificationList" style="width: 320px; max-height: 400px; overflow-y: auto;">
                                    <li><h6 class="dropdown-header fw-bold text-dark">Thông báo <span id="notificationCountHeader" class="badge bg-secondary ms-1">0</span></h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <!-- Notifications will be injected here -->
                                    <li id="noNotificationItem"><span class="dropdown-item text-muted text-center" style="font-size: 0.85em; white-space: normal;">Chưa có thông báo nào.</span></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (Context.Session.GetString("IsAdmin") == "True")
                                    {
                                        <li><a class="dropdown-item" asp-page="/Admin/Dashboard/Index"><i class="bi bi-bar-chart-line"></i> Báo cáo thống kê</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Accounts/Index"><i class="bi bi-people"></i> Quản lý tài khoản</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/AuditLogs/Index"><i class="bi bi-journal-text"></i> Audit Logs</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    else if (Context.Session.GetString("Role") == "Staff")
                                    {
                                        <li><a class="dropdown-item" asp-page="/Staff/Categories/Index"><i class="bi bi-tags"></i> Quản lý Danh mục</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/Tags/Index"><i class="bi bi-hash"></i> Quản lý Tags</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/News/Index"><i class="bi bi-newspaper"></i> Quản lý Bài viết</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/Profile/Index"><i class="bi bi-person-badge"></i> Hồ sơ cá nhân</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item" asp-page="/Auth/Logout"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Auth/Login"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <!-- Offline Banner -->
            @{
                var isOfflineMode = Context.Items.ContainsKey("IsOfflineMode") && (bool)Context.Items["IsOfflineMode"];
                var displayStyle = isOfflineMode ? "block" : "none";
            }
            <div id="offlineBanner" class="alert alert-warning text-center fw-bold sticky-top z-3" role="alert" style="display: @displayStyle;">
                <i class="bi bi-wifi-off me-2"></i> ⚠️ Offline Mode: Bạn đang xem dữ liệu offline. Kết nối đến máy chủ bị gián đoạn. Các chức năng tạm thời bị vô hiệu hóa.
            </div>

            <!-- Toast Container -->
            <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>

            @if (TempData["SuccessMessage"] != null)
            {
                var toastId = Guid.NewGuid().ToString();
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        var id = 'toast_' + '@toastId';
                        if (!sessionStorage.getItem(id)) {
                            showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');
                            sessionStorage.setItem(id, 'true');
                        }
                    });
                </script>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                var toastId = Guid.NewGuid().ToString();
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        var id = 'toast_' + '@toastId';
                        if (!sessionStorage.getItem(id)) {
                            showToast('@Html.Raw(TempData["ErrorMessage"])', 'danger');
                            sessionStorage.setItem(id, 'true');
                        }
                    });
                </script>
            }
            @if (TempData["InfoMessage"] != null)
            {
                var toastId = Guid.NewGuid().ToString();
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        var id = 'toast_' + '@toastId';
                        if (!sessionStorage.getItem(id)) {
                            showToast('@Html.Raw(TempData["InfoMessage"])', 'info');
                            sessionStorage.setItem(id, 'true');
                        }
                    });
                </script>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-5">
        <div class="container">
            <small>&copy; 2026 - FU News Management v2 | Assignment 02</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>