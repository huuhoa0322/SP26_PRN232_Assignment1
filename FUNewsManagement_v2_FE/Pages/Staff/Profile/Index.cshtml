@page
@model FUNewsManagement_v2_FE.Pages.Staff.Profile.IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person-circle"></i> Hồ sơ cá nhân</h4>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control" value="@Model.CurrentAccount?.AccountEmail" readonly disabled />
                        <small class="text-muted">Email không thể thay đổi</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Profile.AccountName" class="form-label">Họ và Tên</label>
                        <input asp-for="Profile.AccountName" class="form-control" required />
                        <span asp-validation-for="Profile.AccountName" class="text-danger"></span>
                    </div>

                    <hr class="my-4" />
                    <h5>Đổi mật khẩu</h5>
                    <p class="text-muted"><small>Để trống nếu không muốn đổi mật khẩu.</small></p>

                    <div class="mb-3">
                        <label asp-for="Profile.OldPassword" class="form-label">Mật khẩu cũ</label>
                        <input asp-for="Profile.OldPassword" type="password" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Profile.NewPassword" class="form-label">Mật khẩu mới</label>
                        <input asp-for="Profile.NewPassword" type="password" class="form-control" />
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
