@page
@model FUNewsManagement_v2_FE.Pages.Staff.Categories.IndexModel
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý Danh mục</h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="openCreateModal()">
        <i class="bi bi-plus-circle"></i> Thêm danh mục
    </button>
</div>

<!-- Search & Filter Form -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-10">
                <input type="text" id="searchKeyword" class="form-control" placeholder="Tìm kiếm theo tên hoặc mô tả danh mục..." />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" onclick="searchCategories()">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên</th>
            <th>Danh mục cha</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Số bài viết</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody id="categoriesTableBody">
        <tr>
            <td colspan="7" class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </td>
        </tr>
    </tbody>
</table>

<!-- Pagination -->
<div id="pagination" class="d-flex justify-content-center"></div>

<!-- Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="categoryId" />
                <input type="hidden" id="isEditMode" value="false" />

                <div class="mb-3">
                    <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                    <input type="text" id="categoryName" class="form-control" required maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả <span class="text-danger">*</span></label>
                    <textarea id="categoryDesc" class="form-control" rows="3" required maxlength="250"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Danh mục cha</label>
                    <select id="parentCategoryId" class="form-select">
                        <option value="">-- Không có (Danh mục gốc) --</option>
                    </select>
                    <small class="form-text text-muted" id="parentCategoryHelp" style="display: none;">
                        <i class="bi bi-info-circle"></i> Không thể thay đổi danh mục cha vì đã có bài viết
                    </small>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input type="checkbox" id="isActive" class="form-check-input" checked />
                        <label class="form-check-label">Hoạt động</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn xóa danh mục: <strong id="deleteName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="deleteId" />
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="deleteCategory()">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage = 1;
    let pageSize = 10;
    let categoryModal, deleteModal;
    let allCategories = []; // For parent dropdown

    document.addEventListener('DOMContentLoaded', function() {
        categoryModal = new bootstrap.Modal(document.getElementById('categoryModal'));
        deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        loadCategories();
        loadAllCategoriesForDropdown();
    });

    function searchCategories() {
        currentPage = 1;
        loadCategories();
    }

    async function loadCategories() {
        const keyword = document.getElementById('searchKeyword').value.trim();

        // Build filter
        let filter = null;
        if (keyword) {
            const lowerKeyword = keyword.toLowerCase();
            filter = `contains(tolower(CategoryName), '${lowerKeyword}') or contains(tolower(CategoryDesciption), '${lowerKeyword}')`;
        }

        try {
            const response = await fetch(`/api/categories?filter=${encodeURIComponent(filter || '')}&orderby=CategoryId asc&top=${pageSize}&skip=${(currentPage-1)*pageSize}`);
            const data = await response.json();

            if (data && data.value) {
                renderCategoriesTable(data.value);
                renderPagination(data.count || data.value.length);
            }
        } catch (error) {
            console.error('Error loading categories:', error);
            showToast('Lỗi khi tải danh sách danh mục', 'danger');
        }
    }

    async function loadAllCategoriesForDropdown() {
        try {
            const response = await fetch(`/api/categories?orderby=CategoryId asc&top=100`, {
                credentials: 'same-origin'
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();

            if (data && data.value) {
                allCategories = data.value;
                updateParentDropdown();
            }
        } catch (error) {
            console.error('Error loading categories for dropdown:', error);
        }
    }

    function updateParentDropdown() {
        const select = document.getElementById('parentCategoryId');
        const currentId = document.getElementById('categoryId').value;

        // Keep the default option
        select.innerHTML = '<option value="">-- Không có (Danh mục gốc) --</option>';

        allCategories.forEach(cat => {
            // Don't allow selecting self as parent
            if (cat.categoryId != currentId) {
                const option = document.createElement('option');
                option.value = cat.categoryId;
                option.textContent = cat.categoryName;
                select.appendChild(option);
            }
        });
    }

    function renderCategoriesTable(categories) {
        const tbody = document.getElementById('categoriesTableBody');
        if (categories.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>';
            return;
        }

        tbody.innerHTML = categories.map(cat => `
            <tr>
                <td>${cat.categoryId}</td>
                <td>${cat.categoryName || ''}</td>
                <td>
                    ${cat.parentCategoryName 
                        ? `<span class="badge bg-info text-dark">${cat.parentCategoryName}</span>` 
                        : '<span class="text-muted fst-italic">Danh mục gốc</span>'}
                </td>
                <td>${cat.categoryDesciption || ''}</td>
                <td>
                    <span class="badge ${cat.isActive ? 'bg-success' : 'bg-secondary'}">
                        ${cat.isActive ? 'Hoạt động' : 'Không hoạt động'}
                    </span>
                </td>
                <td>${cat.newsCount || 0}</td>
                <td>
                    <button type="button" class="btn btn-sm btn-warning" onclick='openEditModal(${JSON.stringify(cat)})'>
                        <i class="bi bi-pencil"></i> Sửa
                    </button>
                    <button type="button" class="btn btn-sm btn-danger" onclick='openDeleteModal(${cat.categoryId}, ${JSON.stringify(cat.categoryName || "")})'>
                        <i class="bi bi-trash"></i> Xóa
                    </button>
                </td>
            </tr>
        `).join('');
    }

    function renderPagination(total) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = document.getElementById('pagination');

        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        let html = '<ul class="pagination">';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">Trước</a>
                 </li>`;

        for (let i = 1; i <= totalPages; i++) {
            html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                     </li>`;
        }

        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">Sau</a>
                 </li>`;
        html += '</ul>';

        pagination.innerHTML = html;
    }

    function changePage(page) {
        currentPage = page;
        loadCategories();
    }

    function openCreateModal() {
        document.getElementById('modalTitle').textContent = 'Thêm danh mục';
        document.getElementById('isEditMode').value = 'false';
        document.getElementById('categoryId').value = '';
        document.getElementById('categoryName').value = '';
        document.getElementById('categoryDesc').value = '';
        document.getElementById('parentCategoryId').value = '';
        document.getElementById('parentCategoryId').disabled = false;
        document.getElementById('parentCategoryHelp').style.display = 'none';
        document.getElementById('isActive').checked = true;

        updateParentDropdown();
        categoryModal.show();
    }

    function openEditModal(category) {
        document.getElementById('modalTitle').textContent = 'Sửa danh mục';
        document.getElementById('isEditMode').value = 'true';
        document.getElementById('categoryId').value = category.categoryId;
        document.getElementById('categoryName').value = category.categoryName;
        document.getElementById('categoryDesc').value = category.categoryDesciption || '';
        document.getElementById('isActive').checked = category.isActive;

        updateParentDropdown();

        // Set parent category
        document.getElementById('parentCategoryId').value = category.parentCategoryId || '';

        // Disable ParentCategoryId if category has articles
        if (category.newsCount > 0) {
            document.getElementById('parentCategoryId').disabled = true;
            document.getElementById('parentCategoryHelp').style.display = 'block';
        } else {
            document.getElementById('parentCategoryId').disabled = false;
            document.getElementById('parentCategoryHelp').style.display = 'none';
        }

        categoryModal.show();
    }

    function openDeleteModal(id, name) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteName').textContent = name;
        deleteModal.show();
    }

    async function saveCategory() {
        const isEdit = document.getElementById('isEditMode').value === 'true';
        const id = document.getElementById('categoryId').value;
        const name = document.getElementById('categoryName').value.trim();
        const desc = document.getElementById('categoryDesc').value.trim();
        const parentId = document.getElementById('parentCategoryId').value;
        const isActive = document.getElementById('isActive').checked;

        if (!name || !desc) {
            showToast('Vui lòng điền đầy đủ thông tin', 'danger');
            return;
        }

        const data = {
            categoryName: name,
            categoryDesciption: desc,
            parentCategoryId: parentId ? parseInt(parentId) : null,
            isActive: isActive
        };

        try {
            const url = isEdit ? `/api/categories/${id}` : '/api/categories';
            const method = isEdit ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(data)
            });

            if (response.ok) {
                showToast(isEdit ? 'Cập nhật danh mục thành công!' : 'Tạo danh mục thành công!', 'success');
                categoryModal.hide();
                loadCategories();
                loadAllCategoriesForDropdown();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error saving category:', error);
            showToast('Lỗi khi lưu danh mục: ' + error.message, 'danger');
        }
    }

    async function deleteCategory() {
        const id = document.getElementById('deleteId').value;

        try {
            const response = await fetch(`/api/categories/${id}`, {
                method: 'DELETE'
            });

            if (response.ok) {
                showToast('Xóa danh mục thành công!', 'success');
                deleteModal.hide();
                loadCategories();
                loadAllCategoriesForDropdown();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error deleting category:', error);
            showToast('Lỗi khi xóa danh mục', 'danger');
        }
    }

    function showToast(message, type) {
        // Create toast element if not exists
        let toastContainer = document.querySelector('.toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
            toastContainer.style.zIndex = '9999';
            document.body.appendChild(toastContainer);
        }

        const toastId = 'toast-' + Date.now();
        const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';

        const toastHTML = `
            <div id="${toastId}" class="toast align-items-center text-white ${bgClass} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `;

        toastContainer.insertAdjacentHTML('beforeend', toastHTML);

        const toastElement = document.getElementById(toastId);
        const toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 3000 });
        toast.show();

        // Remove toast element after hidden
        toastElement.addEventListener('hidden.bs.toast', function() {
            toastElement.remove();
        });
    }
</script>
}
