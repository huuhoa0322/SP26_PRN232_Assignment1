@page
@model FUNewsManagement_v2_FE.Pages.Staff.News.IndexModel
@{
    ViewData["Title"] = "Quản lý Bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý Bài viết</h2>
    <button type="button" class="btn btn-primary" onclick="openCreateModal()">
        <i class="bi bi-plus-circle"></i> Thêm bài viết
    </button>
</div>

<!-- Search & Filter Form -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col">
                <label class="form-label">Tìm kiếm</label>
                <input type="text" id="searchKeyword" class="form-control form-control-sm" placeholder="Tiêu đề, Headline..." />
            </div>
            <div class="col">
                <label class="form-label">Danh mục</label>
                <select id="searchCategoryId" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label">Trạng thái</label>
                <select id="searchStatus" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="true">Hoạt động</option>
                    <option value="false">Không hoạt động</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label">Từ ngày</label>
                <input type="date" id="startDate" class="form-control form-control-sm" />
            </div>
            <div class="col">
                <label class="form-label">Đến ngày</label>
                <input type="date" id="endDate" class="form-control form-control-sm" />
            </div>
            <div class="col-auto d-flex align-items-end gap-1">
                <button type="button" class="btn btn-primary btn-sm" onclick="searchNews()">Tìm</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="resetSearch()">Làm mới</button>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="table-responsive">
<table class="table table-striped table-hover table-sm align-middle" style="font-size: 0.85rem;">
    <thead class="table-dark">
        <tr>
            <th class="text-nowrap text-center">Ảnh</th>
            <th class="text-nowrap text-center">Tiêu đề</th>
            <th class="text-nowrap text-center">Danh mục</th>
            <th class="text-nowrap text-center">Tác giả</th>
            <th class="text-nowrap text-center">Ngày tạo</th>
            <th class="text-nowrap text-center">Người sửa cuối</th>
            <th class="text-nowrap text-center">Ngày sửa</th>
            <th class="text-nowrap text-center">Trạng thái</th>
            <th class="text-nowrap text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody id="newsTableBody">
        <tr>
            <td colspan="9" class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </td>
        </tr>
    </tbody>
</table>
</div>

<!-- Pagination -->
<div id="pagination" class="d-flex justify-content-center"></div>

<!-- News Modal -->
<div class="modal fade" id="newsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm bài viết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="newsId" />
                <input type="hidden" id="isEditMode" value="false" />
                
                <div class="row mb-3">
                    <div class="col-md-8">
                        <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                        <input type="text" id="newsTitle" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                        <select id="newsCategoryId" class="form-select" required>
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Headline <span class="text-danger">*</span></label>
                    <textarea id="newsHeadline" class="form-control" rows="2" required maxlength="300"></textarea>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Nội dung</label>
                    <textarea id="newsContent" class="form-control" rows="5"></textarea>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Nguồn</label>
                        <input type="text" id="newsSource" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tags</label>
                        <select id="newsTags" class="form-select" multiple size="3">
                        </select>
                        <small class="text-muted">Giữ Ctrl để chọn nhiều tags</small>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Ảnh</label>
                        <input type="file" id="newsImage" class="form-control" accept="image/*" />
                        <div id="currentImagePreview" style="display:none; margin-top: 10px;">
                            <img id="currentImage" src="" alt="Current" style="max-width: 200px; max-height: 200px;" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check mt-4">
                            <input type="checkbox" id="newsStatus" class="form-check-input" checked />
                            <label class="form-check-label">Hoạt động</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveNews()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn xóa bài viết: <strong id="deleteName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="deleteId" />
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="deleteNews()">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const API_BASE_URL = '@(ViewContext.HttpContext.RequestServices.GetRequiredService<IConfiguration>()["CoreApiSettings:BaseUrl"] ?? "http://localhost:5042")';
    let currentPage = 1;
    let pageSize = 10;
    let newsModal, deleteModal;
    let categories = [];
    let tags = [];
    let currentUserId = null;

    document.addEventListener('DOMContentLoaded', function() {
        newsModal = new bootstrap.Modal(document.getElementById('newsModal'));
        deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        loadCategories();
        loadTags();
        loadNews();
        getCurrentUserId();
    });

    function searchNews() {
        currentPage = 1;
        loadNews();
    }

    function resetSearch() {
        document.getElementById('searchKeyword').value = '';
        document.getElementById('searchCategoryId').value = '';
        document.getElementById('searchStatus').value = '';
        document.getElementById('startDate').value = '';
        document.getElementById('endDate').value = '';
        currentPage = 1;
        loadNews();
    }

    async function getCurrentUserId() {
        try {
            const response = await fetch('/api/profile');
            if (response.ok) {
                const profile = await response.json();
                currentUserId = profile.accountId;
            }
        } catch (error) {
            console.error('Error getting current user:', error);
        }
    }

    async function loadCategories() {
        try {
            const response = await fetch('/api/categories?orderby=CategoryName asc&top=100');
            const data = await response.json();
            
            if (data && data.value) {
                categories = data.value.filter(c => c.isActive);
                updateCategoryDropdowns();
            }
        } catch (error) {
            console.error('Error loading categories:', error);
        }
    }

    async function loadTags() {
        try {
            const response = await fetch('/api/tags?orderby=TagName asc&top=100', {
                credentials: 'same-origin'
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();

            if (data && data.value) {
                tags = data.value;
                updateTagsDropdown();
            }
        } catch (error) {
            console.error('Error loading tags:', error);
        }
    }

    function updateCategoryDropdowns() {
        const searchSelect = document.getElementById('searchCategoryId');
        const newsSelect = document.getElementById('newsCategoryId');
        
        searchSelect.innerHTML = '<option value="">-- Tất cả --</option>';
        newsSelect.innerHTML = '<option value="">-- Chọn danh mục --</option>';
        
        categories.forEach(cat => {
            const option1 = new Option(cat.categoryName, cat.categoryId);
            const option2 = new Option(cat.categoryName, cat.categoryId);
            searchSelect.add(option1);
            newsSelect.add(option2);
        });
    }

    function updateTagsDropdown() {
        const select = document.getElementById('newsTags');
        select.innerHTML = '';
        
        tags.forEach(tag => {
            const option = new Option(tag.tagName, tag.tagId);
            select.add(option);
        });
    }

    async function loadNews() {
        const keyword = document.getElementById('searchKeyword').value.trim();
        const categoryId = document.getElementById('searchCategoryId').value;
        const status = document.getElementById('searchStatus').value;
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        
        // Build filter
        let filters = [];
        if (keyword) {
            filters.push(`(contains(NewsTitle, '${keyword}') or contains(Headline, '${keyword}'))`);
        }
        if (categoryId) {
            filters.push(`CategoryId eq ${categoryId}`);
        }
        if (status !== '') {
            filters.push(`NewsStatus eq ${status}`);
        }
        if (startDate) {
            filters.push(`CreatedDate ge ${startDate}T00:00:00Z`);
        }
        if (endDate) {
            const endDateTime = new Date(endDate);
            endDateTime.setDate(endDateTime.getDate() + 1);
            filters.push(`CreatedDate lt ${endDateTime.toISOString()}`);
        }
        
        const filterStr = filters.length > 0 ? filters.join(' and ') : null;
        
        try {
            const response = await fetch(`/api/news?filter=${encodeURIComponent(filterStr || '')}&orderby=CreatedDate desc&top=${pageSize}&skip=${(currentPage-1)*pageSize}`);
            const data = await response.json();
            
            if (data && data.value) {
                renderNewsTable(data.value);
                renderPagination(data.count || data.value.length);
            }
        } catch (error) {
            console.error('Error loading news:', error);
            showToast('Lỗi khi tải danh sách bài viết', 'danger');
        }
    }

    function renderNewsTable(news) {
        const tbody = document.getElementById('newsTableBody');
        if (news.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">Không có dữ liệu</td></tr>';
            return;
        }

        tbody.innerHTML = news.map(article => {
            const canDelete = currentUserId && (article.createdById === currentUserId);
            return `
                <tr>
                    <td>
                        ${article.imageUrl 
                            ? `<img src="${API_BASE_URL}/${article.imageUrl}" alt="Thumb" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;" />` 
                            : '<span class="text-muted"><i class="bi bi-image"></i></span>'}
                    </td>
                    <td style="max-width: 300px;">
                        <div class="fw-bold text-truncate" title="${article.newsTitle || ''}">${article.newsTitle || ''}</div>
                        <small class="text-muted text-truncate d-block" title="${article.headline || ''}">${article.headline || ''}</small>
                    </td>
                    <td>${article.categoryName || ''}</td>
                    <td>${article.createdByName || ''}</td>
                    <td>${article.createdDate ? new Date(article.createdDate).toLocaleString('vi-VN') : ''}</td>
                    <td>${article.updatedByName || ''}</td>
                    <td>${article.modifiedDate ? new Date(article.modifiedDate).toLocaleString('vi-VN') : ''}</td>
                    <td>
                        <span class="badge ${article.newsStatus ? 'bg-success' : 'bg-secondary'}">
                            ${article.newsStatus ? 'Hoạt động' : 'Không hoạt động'}
                        </span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-warning" onclick='openEditModal(${JSON.stringify(article).replace(/'/g, "&apos;")})'>
                            Sửa
                        </button>
                        <button type="button" class="btn btn-sm btn-info" onclick='duplicateNews("${article.newsArticleId}")'>
                            Sao chép
                        </button>
                        ${canDelete ? `
                            <button type="button" class="btn btn-sm btn-danger" onclick='openDeleteModal("${article.newsArticleId}", ${JSON.stringify(article.newsTitle || "")})'>
                                Xóa
                            </button>
                        ` : ''}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function renderPagination(total) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = document.getElementById('pagination');
        
        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        let html = '<ul class="pagination">';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">Trước</a>
                 </li>`;
        
        for (let i = 1; i <= totalPages; i++) {
            html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                     </li>`;
        }
        
        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">Sau</a>
                 </li>`;
        html += '</ul>';
        
        pagination.innerHTML = html;
    }

    function changePage(page) {
        currentPage = page;
        loadNews();
    }

    function openCreateModal() {
        document.getElementById('modalTitle').textContent = 'Thêm bài viết';
        document.getElementById('isEditMode').value = 'false';
        document.getElementById('newsId').value = '';
        document.getElementById('newsTitle').value = '';
        document.getElementById('newsHeadline').value = '';
        document.getElementById('newsContent').value = '';
        document.getElementById('newsSource').value = '';
        document.getElementById('newsCategoryId').value = '';
        document.getElementById('newsStatus').checked = true;
        document.getElementById('newsImage').value = '';
        document.getElementById('currentImagePreview').style.display = 'none';
        
        // Clear tag selection
        Array.from(document.getElementById('newsTags').options).forEach(opt => opt.selected = false);
        
        newsModal.show();
    }

    function openEditModal(article) {
        document.getElementById('modalTitle').textContent = 'Sửa bài viết';
        document.getElementById('isEditMode').value = 'true';
        document.getElementById('newsId').value = article.newsArticleId;
        document.getElementById('newsTitle').value = article.newsTitle || '';
        document.getElementById('newsHeadline').value = article.headline || '';
        document.getElementById('newsContent').value = article.newsContent || '';
        document.getElementById('newsSource').value = article.newsSource || '';
        document.getElementById('newsCategoryId').value = article.categoryId || '';
        document.getElementById('newsStatus').checked = article.newsStatus;
        document.getElementById('newsImage').value = '';
        
        // Show current image if exists
        if (article.imageUrl) {
            document.getElementById('currentImage').src = `${API_BASE_URL}/${article.imageUrl}`;
            document.getElementById('currentImagePreview').style.display = 'block';
        } else {
            document.getElementById('currentImagePreview').style.display = 'none';
        }
        
        // Set tags
        const articleTagIds = (article.tags || []).map(t => t.tagId);
        Array.from(document.getElementById('newsTags').options).forEach(opt => {
            opt.selected = articleTagIds.includes(parseInt(opt.value));
        });
        
        newsModal.show();
    }

    function openDeleteModal(id, title) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteName').textContent = title;
        deleteModal.show();
    }

    async function saveNews() {
        const isEdit = document.getElementById('isEditMode').value === 'true';
        const id = document.getElementById('newsId').value;
        const title = document.getElementById('newsTitle').value.trim();
        const headline = document.getElementById('newsHeadline').value.trim();
        const content = document.getElementById('newsContent').value.trim();
        const source = document.getElementById('newsSource').value.trim();
        const categoryId = document.getElementById('newsCategoryId').value;
        const status = document.getElementById('newsStatus').checked;
        const imageFile = document.getElementById('newsImage').files[0];
        
        // Get selected tags
        const tagSelect = document.getElementById('newsTags');
        const selectedTags = Array.from(tagSelect.selectedOptions).map(opt => parseInt(opt.value));

        if (!title || !headline || !categoryId) {
            showToast('Vui lòng điền đầy đủ thông tin bắt buộc', 'danger');
            return;
        }

        const formData = new FormData();
        formData.append('NewsTitle', title);
        formData.append('Headline', headline);
        formData.append('NewsContent', content);
        formData.append('NewsSource', source);
        formData.append('CategoryId', categoryId);
        formData.append('NewsStatus', status);
        
        selectedTags.forEach(tagId => {
            formData.append('TagIds', tagId);
        });
        
        if (imageFile) {
            formData.append('ImageFile', imageFile);
        }

        try {
            const url = isEdit ? `/api/news/${id}` : '/api/news';
            const method = isEdit ? 'PUT' : 'POST';
            
            const response = await fetch(url, {
                method: method,
                body: formData
            });

            if (response.ok) {
                showToast(isEdit ? 'Cập nhật bài viết thành công!' : 'Tạo bài viết thành công!', 'success');
                newsModal.hide();
                loadNews();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error saving news:', error);
            showToast('Lỗi khi lưu bài viết', 'danger');
        }
    }

    async function duplicateNews(id) {

        try {
            const response = await fetch(`/api/news/${id}/duplicate`, {
                method: 'POST',
                credentials: 'same-origin'
            });

            if (response.ok) {
                showToast('Sao chép bài viết thành công!', 'success');
                loadNews();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error duplicating news:', error);
            showToast('Lỗi khi sao chép bài viết', 'danger');
        }
    }

    async function deleteNews() {
        const id = document.getElementById('deleteId').value;

        try {
            const response = await fetch(`/api/news/${id}`, {
                method: 'DELETE',
                credentials: 'same-origin'
            });

            if (response.ok) {
                showToast('Xóa bài viết thành công!', 'success');
                deleteModal.hide();
                loadNews();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error deleting news:', error);
            showToast('Lỗi khi xóa bài viết: ' + error.message, 'danger');
        }
    }

    function showToast(message, type) {
        let toastContainer = document.querySelector('.toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
            toastContainer.style.zIndex = '9999';
            document.body.appendChild(toastContainer);
        }

        const toastId = 'toast-' + Date.now();
        const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
        
        const toastHTML = `
            <div id="${toastId}" class="toast align-items-center text-white ${bgClass} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `;
        
        toastContainer.insertAdjacentHTML('beforeend', toastHTML);
        
        const toastElement = document.getElementById(toastId);
        const toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 3000 });
        toast.show();
        
        toastElement.addEventListener('hidden.bs.toast', function() {
            toastElement.remove();
        });
    }
</script>
}
