@page
@model FUNewsManagement_v2_FE.Pages.Staff.Tags.IndexModel
@{
    ViewData["Title"] = "Quản lý Tags";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý Tags</h2>
    <button type="button" id="btnAddTag" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#tagModal" onclick="openCreateModal()">
        <i class="bi bi-plus-circle"></i> Thêm Tag
    </button>
</div>

<!-- Search & Filter Form -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-10">
                <input type="text" id="searchKeyword" class="form-control" placeholder="Tìm kiếm theo tên tag hoặc ghi chú..." />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" onclick="searchTags()">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên Tag</th>
            <th>Ghi chú</th>
            <th>Số bài viết</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody id="tagsTableBody">
        <tr>
            <td colspan="5" class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </td>
        </tr>
    </tbody>
</table>

<!-- Pagination -->
<div id="pagination" class="d-flex justify-content-center"></div>

<!-- Tag Modal -->
<div class="modal fade" id="tagModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tagId" />
                <input type="hidden" id="isEditMode" value="false" />
                
                <div class="mb-3">
                    <label class="form-label">Tên Tag <span class="text-danger">*</span></label>
                    <input type="text" id="tagName" class="form-control" required maxlength="50" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Ghi chú</label>
                    <textarea id="tagNote" class="form-control" rows="3" maxlength="500"></textarea>
                    <small class="text-muted">Mô tả chi tiết về tag này</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveTag()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn xóa tag: <strong id="deleteName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="deleteId" />
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="deleteTag()">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage = 1;
    let pageSize = 10;
    let tagModal, deleteModal;

    document.addEventListener('DOMContentLoaded', function() {
        tagModal = new bootstrap.Modal(document.getElementById('tagModal'));
        deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        loadTags();
    });

    function searchTags() {
        currentPage = 1;
        loadTags();
    }

    async function loadTags() {
        const keyword = document.getElementById('searchKeyword').value.trim();

        // Build filter
        let filter = null;
        if (keyword) {
            const lowerKeyword = keyword.toLowerCase();
            filter = `contains(tolower(TagName), '${lowerKeyword}') or contains(tolower(Note), '${lowerKeyword}')`;
        }

        try {
            const response = await fetch(`/api/tags?filter=${encodeURIComponent(filter || '')}&orderby=TagId asc&top=${pageSize}&skip=${(currentPage-1)*pageSize}`, {
                credentials: 'same-origin'
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();

            if (data && data.value) {
                if (data.isOffline) {
                    const banner = document.getElementById('offlineBanner');
                    if (banner) banner.style.display = 'block';
                    
                    const btnAdd = document.getElementById('btnAddTag');
                    if (btnAdd) btnAdd.style.display = 'none';
                } else {
                    const banner = document.getElementById('offlineBanner');
                    if (banner) banner.style.display = 'none';
                    
                    const btnAdd = document.getElementById('btnAddTag');
                    if (btnAdd) btnAdd.style.display = 'inline-block';
                }

                renderTagsTable(data.value, data.isOffline);
                renderPagination(data.count || data.value.length);
            }
        } catch (error) {
            console.error('Error loading tags:', error);
            showToast('Lỗi khi tải danh sách tag: ' + error.message, 'danger');
        }
    }

    function renderTagsTable(tags, isOffline = false) {
        const tbody = document.getElementById('tagsTableBody');
        if (tags.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Không có dữ liệu</td></tr>';
            return;
        }

        tbody.innerHTML = tags.map(tag => `
            <tr>
                <td>${tag.tagId}</td>
                <td><span class="badge bg-info text-dark">#${tag.tagName || ''}</span></td>
                <td>${tag.note || ''}</td>
                <td>
                    ${tag.newsCount > 0 
                        ? `<a href="/Staff/TagArticles?tagId=${tag.tagId}" class="badge bg-primary text-decoration-none">${tag.newsCount} bài viết</a>` 
                        : '<span class="text-muted">0 bài viết</span>'}
                </td>
                <td>
                    ${isOffline 
                        ? '<span class="text-muted"><i class="bi bi-slash-circle"></i> Vô hiệu hóa</span>'
                        : `<button type="button" class="btn btn-sm btn-warning" onclick='openEditModal(${JSON.stringify(tag)})'>
                            <i class="bi bi-pencil"></i> Sửa
                           </button>
                           <button type="button" class="btn btn-sm btn-danger" onclick='openDeleteModal(${tag.tagId}, ${JSON.stringify(tag.tagName || "")})'>
                            <i class="bi bi-trash"></i> Xóa
                           </button>`
                    }
                </td>
            </tr>
        `).join('');
    }

    function renderPagination(total) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = document.getElementById('pagination');
        
        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        let html = '<ul class="pagination">';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">Trước</a>
                 </li>`;
        
        for (let i = 1; i <= totalPages; i++) {
            html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                     </li>`;
        }
        
        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">Sau</a>
                 </li>`;
        html += '</ul>';
        
        pagination.innerHTML = html;
    }

    function changePage(page) {
        currentPage = page;
        loadTags();
    }

    function openCreateModal() {
        document.getElementById('modalTitle').textContent = 'Thêm Tag';
        document.getElementById('isEditMode').value = 'false';
        document.getElementById('tagId').value = '';
        document.getElementById('tagName').value = '';
        document.getElementById('tagNote').value = '';
        tagModal.show();
    }

    function openEditModal(tag) {
        document.getElementById('modalTitle').textContent = 'Sửa Tag';
        document.getElementById('isEditMode').value = 'true';
        document.getElementById('tagId').value = tag.tagId;
        document.getElementById('tagName').value = tag.tagName;
        document.getElementById('tagNote').value = tag.note || '';
        tagModal.show();
    }

    function openDeleteModal(id, name) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteName').textContent = name;
        deleteModal.show();
    }

    async function saveTag() {
        const isEdit = document.getElementById('isEditMode').value === 'true';
        const id = document.getElementById('tagId').value;
        const name = document.getElementById('tagName').value.trim();
        const note = document.getElementById('tagNote').value.trim();

        if (!name) {
            showToast('Vui lòng nhập tên tag', 'danger');
            return;
        }

        const data = {
            tagName: name,
            note: note
        };

        try {
            const url = isEdit ? `/api/tags/${id}` : '/api/tags';
            const method = isEdit ? 'PUT' : 'POST';
            
            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                showToast(isEdit ? 'Cập nhật tag thành công!' : 'Tạo tag thành công!', 'success');
                tagModal.hide();
                loadTags();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error saving tag:', error);
            showToast('Lỗi khi lưu tag', 'danger');
        }
    }

    async function deleteTag() {
        const id = document.getElementById('deleteId').value;

        try {
            const response = await fetch(`/api/tags/${id}`, {
                method: 'DELETE',
                credentials: 'same-origin'
            });

            if (response.ok) {
                showToast('Xóa tag thành công!', 'success');
                deleteModal.hide();
                loadTags();
            } else {
                const errorText = await response.text();
                let errorMsg = errorText;
                try { const j = JSON.parse(errorText); if (j.message) errorMsg = j.message; } catch(e) {}
                showToast(errorMsg, 'danger');
            }
        } catch (error) {
            console.error('Error deleting tag:', error);
            showToast('Lỗi khi xóa tag: ' + error.message, 'danger');
        }
    }

    function showToast(message, type) {
        // Create toast element if not exists
        let toastContainer = document.querySelector('.toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
            toastContainer.style.zIndex = '9999';
            document.body.appendChild(toastContainer);
        }

        const toastId = 'toast-' + Date.now();
        const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
        
        const toastHTML = `
            <div id="${toastId}" class="toast align-items-center text-white ${bgClass} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `;
        
        toastContainer.insertAdjacentHTML('beforeend', toastHTML);
        
        const toastElement = document.getElementById(toastId);
        const toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 3000 });
        toast.show();
        
        // Remove toast element after hidden
        toastElement.addEventListener('hidden.bs.toast', function() {
            toastElement.remove();
        });
    }
</script>
}
